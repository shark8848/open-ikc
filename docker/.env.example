# open-ikc Docker 栈环境变量模板（生产推荐）
# 用法：cp docker/.env.example .env && docker compose up -d
# 生产必改：OPEN_PLATFORM_TOKEN / OPEN_PLATFORM_ADMIN_TOKEN / HAPROXY_STATS_PASSWORD

# ---------- 认证（生产推荐 gateway_header：身份头由前置可信网关注入） ----------
OPEN_PLATFORM_AUTH_MODE=gateway_header
OPEN_PLATFORM_GATEWAY_REQUIRE_BEARER=true
# 启用 HAProxy 将前置网关的 X-Auth-* 头映射为平台身份头（前置网关须剥离客户端伪造的
# X-Auth-* / X-User-* 头；不启用时身份头全部剥离，请求将被平台按未认证拒绝）
HAPROXY_INJECT_IDENTITY=1
OPEN_PLATFORM_TOKEN=replace-with-strong-business-token
OPEN_PLATFORM_ADMIN_TOKEN=replace-with-strong-admin-token

# ---------- 鉴权（可选，deny-overrides） ----------
# OPEN_PLATFORM_AUTHZ_ENABLED=true
# OPEN_PLATFORM_AUTH_SYSTEM=default

# ---------- HAProxy 代理层 ----------
HAPROXY_HTTP_PORT=18080
HAPROXY_STATS_PORT=8404
HAPROXY_STATS_USER=admin
HAPROXY_STATS_PASSWORD=replace-with-strong-stats-password

# ---------- 日志中心（默认开启；LOG_CENTER_URL 需容器可达） ----------
# ikc-log-center 以 host 网络部署在宿主机时，容器内用 docker0 网关 172.17.0.1 访问；
# Docker Desktop（macOS/Windows）用 http://host.docker.internal:9315。
# 启动时 entrypoint 会预检 {LOG_CENTER_URL}/health，不可达则容器 fail-fast。
LOG_CENTER_ENABLE=true
LOG_CENTER_URL=http://172.17.0.1:9315
# LOG_CENTER_TOKEN=日志中心开启 Bearer 认证时的 token

# ---------- 检索下游（按需切换） ----------
# OPEN_PLATFORM_SEARCH_BACKEND=ur
# OPEN_PLATFORM_UR_BASE_URL=http://127.0.0.1:8096
# OPEN_PLATFORM_OPENAI_SEARCH_BASE_URL=http://127.0.0.1:8088/km/search-api/aiTools/openai/bsapi
